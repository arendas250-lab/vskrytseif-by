# Единый канонический вариант URL: https://вскрытьсейф.бел/ (punycode ниже).
# Без www, всегда https, каталоги — со слешем на конце, без index.php / index.html
# и без повторяющихся слешей. Каждое правило редиректит сразу на итоговый URL
# канонического хоста, поэтому цепочки редиректов не возникает.
# Требует Apache/LiteSpeed с mod_rewrite. Для nginx см. nginx.conf.example.

DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Схлопываем повторяющиеся слеши внутри пути (на случай, если сервер их не склеил сам)
RewriteRule ^(.*?)//+(.*)$ $1/$2 [N]

# 301: /index.php, /index.html, /index.htm -> корень
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+index\.(?:php|html?)(?:[?\s]|$) [NC]
RewriteRule ^ https://xn--b1agmc4aechv9dm.xn--90ais/ [R=301,L]

# 301: /раздел/index.php, /раздел/index.html -> /раздел/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+[^?\s]*/index\.(?:php|html?)(?:[?\s]|$) [NC]
RewriteRule ^(.+)/index\.(?:php|html?)$ https://xn--b1agmc4aechv9dm.xn--90ais/$1/ [NC,R=301,L]

# 301: повторяющиеся слеши в исходном запросе (//, /about//) -> один слеш
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s[^?\s]*//
RewriteRule ^(.*)$ https://xn--b1agmc4aechv9dm.xn--90ais/$1 [R=301,L]

# 301: существующий каталог без слеша на конце -> со слешем
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://xn--b1agmc4aechv9dm.xn--90ais/$1/ [R=301,L]

# 301: www и любой другой хост, а также http -> https://вскрытьсейф.бел (одним редиректом)
RewriteCond %{HTTP_HOST} !^xn--b1agmc4aechv9dm\.xn--90ais$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://xn--b1agmc4aechv9dm.xn--90ais%{REQUEST_URI} [R=301,L]
