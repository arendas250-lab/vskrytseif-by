# ЗАГЛУШКА: домен в правилах ниже (vskrytseif.by) — подтвердить реальный перед деплоем.
# Требует Apache с mod_rewrite. Для nginx см. nginx.conf.example в этой же папке.

RewriteEngine On

# 301: HTTP -> HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 301: www -> без www (единый вариант домена; поменять местами, если решено оставить www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/%1 [L,R=301]

# 301: без завершающего слеша -> со слешем (для путей-каталогов без расширения файла)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{2,5}|/)$
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

ErrorDocument 404 /404.html
